<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cloudverse — Digital Marketing Services</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --navy: #030305; --navy2: #080814; --white: #ffffff;
            --blue: #3b82f6; --indigo: #4f46e5; --cyan: #06b6d4;
            --text-dark: #0f0f1e; --text-mid: #3d3d5c;
        }
        html { scroll-behavior: smooth; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: var(--navy); color: var(--white); overflow-x: hidden; -webkit-font-smoothing: antialiased; }

        /* NAVBAR */
        .navbar { position: fixed; top: 24px; left: 50%; transform: translateX(-50%); width: min(calc(100% - 48px), 1080px); height: 56px; background: rgba(255,255,255,0.95); backdrop-filter: blur(12px); border-radius: 999px; display: flex; align-items: center; justify-content: space-between; padding: 0 8px 0 24px; z-index: 9999; box-shadow: 0 4px 24px rgba(0,0,0,0.2); animation: navIn .8s cubic-bezier(.22,1,.36,1) both; }
        @keyframes navIn { from{opacity:0;transform:translateX(-50%) translateY(-14px);} to{opacity:1;transform:translateX(-50%) translateY(0);} }
        .nav-brand { display:flex; align-items:center; gap:10px; text-decoration:none; letter-spacing:-0.02em; }
        .logo-text { font-family: 'Space Grotesk', sans-serif; font-size: 20px; font-weight: 700; background: linear-gradient(135deg, #01b8fd, #4f46e5); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .brand-atom { font-size: 24px; color: #01b8fd; filter: drop-shadow(0 0 12px rgba(1, 184, 253, 0.4)); display: inline-block; line-height: 1; }
        .nav-brand .brand-atom { animation: rotate 10s linear infinite; }
        @keyframes rotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .nav-links { display:flex; gap:32px; list-style:none; }
        .nav-links a { text-decoration:none; color:#3d3d5c; font-size:14px; font-weight:600; transition:color .2s; }
        .nav-links a:hover { color:#000; }
        .nav-right { display:flex; align-items:center; gap:8px; }
        .contact-btn { background:#2563eb; color:#fff; border:none; padding:0 24px; height:40px; border-radius:999px; font-size:14px; font-weight:700; cursor:pointer; transition:all .2s; }
        .contact-btn:hover { background:#1d4ed8; }

        /* HERO */
        .hero { position:relative; min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:120px 24px 0; overflow:hidden; background-color:var(--navy); }
        .hero-video { position:absolute; top:50%; left:50%; min-width:100%; min-height:100%; width:auto; height:auto; transform:translateX(-50%) translateY(-50%); object-fit:cover; z-index:0; }
        .hero-overlay { position:absolute; inset:0; background:linear-gradient(to bottom,rgba(3,3,5,.8) 0%,rgba(3,3,5,.1) 40%,rgba(3,3,5,.95) 100%); z-index:1; pointer-events:none; }
        .hero-content { position:relative; z-index:10; display:flex; flex-direction:column; align-items:center; animation:fadeUp .7s .2s ease both; }
        .badge { display:inline-flex; align-items:center; gap:8px; margin-bottom:24px; padding:6px 16px; background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1); border-radius:999px; font-size:12px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:#a78bfa; backdrop-filter:blur(8px); }
        .headline { font-size:clamp(40px,6vw,72px); font-weight:800; line-height:1.05; letter-spacing:-.04em; margin-bottom:24px; max-width:800px; color:#fff; text-shadow:0 10px 30px rgba(0,0,0,.5); }
        .description { font-size:18px; line-height:1.6; color:rgba(255,255,255,.7); max-width:600px; margin-bottom:48px; font-weight:500; }
        .cta-group { display:flex; gap:16px; margin-bottom:80px; }
        .btn-primary { background:#fff; color:#000; border:none; padding:16px 32px; border-radius:999px; font-size:15px; font-weight:700; cursor:pointer; text-decoration:none; transition:all .2s; }
        .btn-primary:hover { background:#f0f0f0; transform:translateY(-2px); }
        .btn-secondary { background:transparent; color:#fff; border:1px solid rgba(255,255,255,.2); padding:16px 32px; border-radius:999px; font-size:15px; font-weight:600; cursor:pointer; text-decoration:none; transition:all .2s; }
        .btn-secondary:hover { background:rgba(255,255,255,.1); border-color:rgba(255,255,255,.4); }
        @keyframes fadeUp { from{opacity:0;transform:translateY(28px);} to{opacity:1;transform:translateY(0);} }

        /* SERVICES — with gradient background image */
        .services {
            position: relative;
            background-color: var(--navy2);
            background-image: url('data:image/avif;base64,');
            background-size: cover;
            background-position: center top;
            background-repeat: no-repeat;
            padding: 140px 40px 120px;
            text-align: center;
            overflow: hidden;
        }
        .srv-glow { position:absolute; top:40%; left:50%; transform:translate(-50%, -50%); width:1200px; height:1000px; background:radial-gradient(circle at center, rgba(168,85,247,0.25) 0%, rgba(79,70,229,0.15) 30%, rgba(6,182,212,0.05) 60%, transparent 80%); filter:blur(80px); pointer-events:none; z-index:1; }
        .section-eyebrow { display:inline-flex; align-items:center; gap:7px; margin-bottom:18px; font-size:13px; font-weight:700; letter-spacing:.07em; text-transform:uppercase; color:rgba(99,170,255,.7); position:relative; z-index:2; }
        .section-eyebrow .ey-dot { width:6px; height:6px; border-radius:50%; background:var(--cyan); }
        .srv-headline { font-size:clamp(28px,4.5vw,48px); font-weight:800; line-height:1.1; letter-spacing:-.03em; margin-bottom:12px; color:#fff; position:relative; z-index:2; }
        .srv-headline .acc { background:linear-gradient(90deg,#93c5fd 0%,#818cf8 50%,#c084fc 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
        .srv-sub { font-size:18px; font-weight:500; color:rgba(255,255,255,0.8); max-width:700px; margin:0 auto 80px; line-height:1.6; text-align:center; position:relative; z-index:2; }
        .services-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:32px; max-width:1240px; margin:0 auto; position:relative; z-index:2; }
        .delivery-card { background:linear-gradient(145deg, rgba(30, 30, 42, 0.9) 0%, rgba(15, 15, 25, 0.95) 100%); backdrop-filter:blur(10px); border:1px solid rgba(255,255,255,0.15); border-radius:32px; padding:40px 32px; text-align:left; transition:all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); position:relative; display:flex; flex-direction:column; gap:28px; height:100%; box-shadow:0 15px 35px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.05); overflow:hidden; }
        .delivery-card::before { content:''; position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent); opacity:0; transition:opacity 0.4s; }
        .delivery-card:hover { border-color:rgba(1,184,253,0.5); transform:translateY(-8px); box-shadow:0 25px 50px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.1); }
        .delivery-card:hover::before { opacity:1; }
        .cat-tag { display:inline-flex; align-items:center; gap:8px; padding:8px 18px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:999px; font-size:13px; font-weight:700; color:#fff; align-self:flex-start; letter-spacing:0.02em; }
        .cat-dot { width:12px; height:12px; border-radius:50%; border:2.5px solid currentColor; display:inline-block; }
        .delivery-title { font-size:26px; font-weight:800; line-height:1.2; color:#fff; margin-bottom:12px; letter-spacing:-0.01em; }
        .check-list { list-style:none; display:flex; flex-direction:column; gap:18px; margin-bottom:auto; position:relative; z-index:2; }
        .check-item { display:flex; align-items:flex-start; gap:14px; font-size:15px; color:#ffffff; line-height:1.5; font-weight:500; text-shadow:0 1px 2px rgba(0,0,0,0.2); }
        .check-icon { flex-shrink:0; width:20px; height:20px; background:#4f46e5; border-radius:50%; display:grid; place-items:center; color:#fff; margin-top:2px; box-shadow:0 2px 8px rgba(79,70,229,0.4); }
        .check-icon svg { width:12px; height:12px; stroke-width:3.5; }
        .learn-more { display:flex; align-items:center; gap:8px; color:var(--cyan); font-size:14px; font-weight:700; text-decoration:none; margin-top:12px; transition:all 0.2s; text-shadow:0 1px 2px rgba(0,0,0,0.3); }
        .learn-more:hover { gap:12px; color:#fff; }
        .ic-foundation { color: #a78bfa; } .ic-validation { color: #f472b6; } .ic-capital { color: #60a5fa; } .ic-growth { color: #818cf8; }

        /* WHY CLOUDVERSE */
        .why { background:#fff; padding:120px 40px; position:relative; overflow:hidden; }
        .why-inner { max-width:1440px; margin:0 auto; }
        .sec-tag-dark { display:inline-flex; align-items:center; gap:7px; margin-bottom:18px; font-size:13px; font-weight:700; letter-spacing:.07em; text-transform:uppercase; color:#7c3aed; }
        .why-headline { font-size:clamp(28px,4vw,48px); font-weight:800; letter-spacing:-.03em; line-height:1.1; margin-bottom:64px; color:#0f0f1e; text-align:center; }
        .why-headline .acc { background:linear-gradient(90deg,#4f46e5,#06b6d4); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }

        /* Adjusted 3-col grid — wider columns for the bigger dial */
        .why-grid { display:grid; grid-template-columns:1fr 680px 1fr; gap:56px; align-items:center; }

        /* Redesigned pain/gain items for better legibility at smaller column widths */
        .pain-col, .gain-col { display:flex; flex-direction:column; gap:16px; justify-content:center; }

        .pain-item, .gain-item {
            padding: 18px 20px;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 600;
            line-height: 1.6;
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }
        .pain-item {
            background: #f7f7fb;
            border: 1px solid #ebebf5;
            color: #7a7a9a;
            border-left: 3px solid #e0e0f0;
        }
        .gain-item {
            background: #f4f4ff;
            border: 1px solid #e0e0f8;
            color: #2d2d4a;
            border-left: 3px solid #4f46e5;
        }

        /* Pain label */
        .pain-label {
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #c0c0d8;
            margin-bottom: 4px;
        }
        .gain-label {
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #818cf8;
            margin-bottom: 4px;
        }

        .pi { flex-shrink:0; width:18px; height:18px; margin-top:2px; color:#d1d1e0; }
        .gi { flex-shrink:0; width:18px; height:18px; margin-top:2px; color:#4f46e5; }
        .item-text { display:flex; flex-direction:column; }

        /* Pain heading inside item */
        .pain-item-title { font-size:14px; font-weight:700; color:#9090b0; line-height:1.4; }
        .gain-item-title { font-size:14px; font-weight:700; color:#1e1e3a; line-height:1.4; }
        .pain-item-sub { font-size:13px; font-weight:500; color:#b0b0cc; line-height:1.5; margin-top:2px; }
        .gain-item-sub { font-size:13px; font-weight:500; color:#6060a0; line-height:1.5; margin-top:2px; }

        /* Mandala dial */
        .center-dial { width:680px; height:680px; border-radius:50%; flex-shrink:0; position:relative; display:grid; place-items:center; overflow:hidden; }
        .dial-video { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; border-radius:50%; }

        /* PROCESS */
        .process { background:#fff; padding:80px 40px 100px; border-top:1px solid #f0f0f5; }
        .process-inner { max-width:1100px; margin:0 auto; }
        .proc-headline { font-size:clamp(26px,4vw,48px); font-weight:800; letter-spacing:-.03em; line-height:1.1; margin-bottom:12px; color:#0f0f1e; text-align:center; }
        .proc-headline .acc { background:linear-gradient(90deg,#4f46e5,#06b6d4,#a855f7); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
        .proc-sub { font-size:16px; font-weight:500; color:#888; max-width:440px; margin:0 auto 60px; text-align:center; line-height:1.65; }
        .proc-cols { display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid #e8e8f0; }
        .proc-col { padding:32px 28px; border-right:1px solid #e8e8f0; }
        .proc-col:last-child { border-right:none; }
        .proc-num { font-size:13px; font-weight:800; color:rgba(79,70,229,.6); letter-spacing:.1em; margin-bottom:10px; }
        .proc-title { font-size:17px; font-weight:800; color:#0f0f1e; margin-bottom:12px; letter-spacing:-.01em; }
        .proc-desc { font-size:14px; font-weight:500; color:#7a7a9a; line-height:1.65; }

        /* CTA BAND */
        .cta-band { background:var(--navy); padding:100px 40px; text-align:center; position:relative; overflow:hidden; }
        .cta-band-glow { position:absolute; inset:0; background:radial-gradient(ellipse 70% 80% at 50% 100%,rgba(79,70,229,.14) 0%,transparent 70%); pointer-events:none; }
        .cta-band h2 { font-size:clamp(28px,4vw,48px); font-weight:800; letter-spacing:-.03em; line-height:1.1; color:#fff; margin-bottom:16px; position:relative; z-index:2; }
        .cta-band h2 span { background:linear-gradient(90deg,#93c5fd,#818cf8,#c084fc); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
        .cta-band p { font-size:16px; font-weight:500; color:rgba(255,255,255,.6); max-width:440px; margin:0 auto 36px; line-height:1.65; position:relative; z-index:2; }
        .cta-band-btns { display:flex; justify-content:center; position:relative; z-index:2; }

        /* FOOTER */
        .footer { background:var(--navy); padding:0 0 60px; }
        .footer-wave { height:120px; width:100%; background-image:url("67ed50fbfb07f55f57a6e461_graphic-p-2000.png"); background-size:auto 100%; background-repeat:repeat-x; background-position:0 center; animation:slideWaveBg 40s linear infinite; margin-bottom:40px; opacity:.9; }
        @keyframes slideWaveBg { from{background-position:0 center;} to{background-position:-2000px center;} }
        .footer-inner { max-width:1100px; margin:0 auto; padding:0 40px; display:flex; justify-content:space-between; align-items:flex-start; gap:40px; flex-wrap:wrap; }
        .footer-brand-col .fb-name { display:flex; align-items:center; gap:10px; margin-bottom:12px; text-decoration:none; }
        .footer-brand-col .fb-name .brand-atom { width:auto; height:auto; background:none; border-radius:0; display:inline-block; }
        .footer-tagline { font-size:14px; font-weight:500; color:rgba(255,255,255,.5); max-width:220px; line-height:1.6; }
        .footer-links { display:flex; gap:64px; flex-wrap:wrap; }
        .footer-col h4 { font-size:12px; font-weight:800; color:rgba(255,255,255,.3); letter-spacing:.1em; text-transform:uppercase; margin-bottom:16px; }
        .footer-col a { display:block; font-size:14px; font-weight:600; color:rgba(255,255,255,.6); text-decoration:none; margin-bottom:12px; transition:color .2s; }
        .footer-col a:hover { color:#fff; }

        /* Reveal & Responsive */
        .reveal { opacity:0; transform:translateY(28px); transition:opacity .7s ease,transform .7s ease; }
        .reveal.visible { opacity:1; transform:translateY(0); }
        .d1{transition-delay:.1s;} .d2{transition-delay:.18s;} .d3{transition-delay:.26s;} .d4{transition-delay:.34s;}

        @media(max-width:1200px) { .why-grid{grid-template-columns:1fr auto 1fr;} .center-dial{width:560px;height:560px;} }
        @media(max-width:960px) { .nav-links{display:none;} .services-grid{grid-template-columns:1fr 1fr;} .why-grid{grid-template-columns:1fr;} .center-dial{display:none;} .proc-cols{grid-template-columns:1fr 1fr;} }
        @media(max-width:600px) { .navbar{width:calc(100% - 32px);padding:0 6px 0 16px;} .services-grid{grid-template-columns:1fr;} .proc-cols{grid-template-columns:1fr;} .cta-group{flex-direction:column;width:100%;max-width:280px;} .cta-band-btns{flex-direction:column;align-items:center;} }
    </style>
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="favicon.svg">
    <script src="favicon.js"></script>
</head>
<body>

<!-- NAVBAR -->
<nav class="navbar">
    <a href="index.html" class="nav-brand">
        <span class="brand-atom">⚛</span>
        <span class="logo-text">Cloudverse</span>
    </a>
    <ul class="nav-links">
        <li><a href="#services">Services</a></li>
        <li><a href="#why">Why Us</a></li>
        <li><a href="#process">Process</a></li>
        <li><a href="#">Thinking</a></li>
    </ul>
    <div class="nav-right">
        <a href="index.html#cta" style="text-decoration: none;"><button class="contact-btn">Contact</button></a>
    </div>
</nav>

<!-- HERO -->
<section class="hero">
    <video class="hero-video" autoplay loop muted playsinline poster="enterprise-hero-poster.jpg">
        <source src="enterprise-hero.mp4" type="video/mp4">
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <div class="badge">Infrastructure Built to Last</div>
        <h1 class="headline">Engineer and scale<br>with clarity.</h1>
        <p class="description">Cloudverse helps infrastructure owner, operator and supplier teams enforce global build standards for mission-critical systems. Align teams, regions and programs without the heavy lifting.</p>
        <div class="cta-group">
            <a href="#services" class="btn-primary">Start Growing</a>
            <a href="index.html" class="btn-secondary">Explore Platform</a>
        </div>
    </div>
</section>

<!-- SERVICES -->
<section class="services" id="services">
    <div class="srv-glow"></div>
    <div class="section-eyebrow reveal"><span class="ey-dot"></span>Our Expertise</div>
    <h2 class="srv-headline reveal">Full-spectrum digital marketing,<br><span class="acc">driven by creativity & technology.</span></h2>
    <p class="srv-sub reveal">From "What if?" to "Wow!" — we blend strategy, creativity, and tech to build brands that don't just exist, but thr    <div class="services-grid">
        <!-- 1. Creative & Digital Strategy -->
        <div class="delivery-card reveal d1">
            <div class="cat-tag ic-foundation"><span class="cat-dot"></span>Strategy</div>
            <div class="card-content">
                <h3 class="delivery-title">Creative & Digital<br>Strategy.</h3>
                <ul class="check-list">
                    <li class="check-item"><span class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Business-aligned strategies</li>
                    <li class="check-item"><span class="check-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Creative research & insights</li>
                </ul>
            </div>
            <a href="#cta" class="learn-more">Partner with us →</a>
        </div>
        <!-- 2. Media Planning & Buying -->
        <div class="delivery-card reveal d2">
            <div class="cat-tag ic-validation"><span class="cat-dot"></span>Media</div>
            <div class="card-content">
                <h3 class="delivery-title">Media Planning &<br>Buying.</h3>
                <ul class="check-list">
                    <li class="check-item"><span class="check-icon" style="background:#f472b6;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Profitable media planning</li>
                    <li class="check-item"><span class="check-icon" style="background:#f472b6;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Marketing goal definition</li>
                </ul>
            </div>
            <a href="#cta" class="learn-more">Scale your ads →</a>
        </div>
        <!-- 3. Analytics & SEO -->
        <div class="delivery-card reveal d3">
            <div class="cat-tag ic-capital"><span class="cat-dot"></span>Performance</div>
            <div class="card-content">
                <h3 class="delivery-title">Analytics &<br>SEO Results.</h3>
                <ul class="check-list">
                    <li class="check-item"><span class="check-icon" style="background:#60a5fa;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Search engine optimization</li>
                    <li class="check-item"><span class="check-icon" style="background:#60a5fa;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Performance-driven insights</li>
                </ul>
            </div>
            <a href="#cta" class="learn-more">Grow rankings →</a>
        </div>
        <!-- 4. Mobile & Website UI/UX -->
        <div class="delivery-card reveal d4">
            <div class="cat-tag ic-growth"><span class="cat-dot"></span>UX/UI</div>
            <div class="card-content">
                <h3 class="delivery-title">Mobile & Website<br>UI/UX Design.</h3>
                <ul class="check-list">
                    <li class="check-item"><span class="check-icon" style="background:#818cf8;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>User-friendly interfaces</li>
                    <li class="check-item"><span class="check-icon" style="background:#818cf8;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Seamless digital experiences</li>
                </ul>
            </div>
            <a href="#cta" class="learn-more">Perfect your design →</a>
        </div>
        <!-- 5. Influencer Management -->
        <div class="delivery-card reveal d5">
